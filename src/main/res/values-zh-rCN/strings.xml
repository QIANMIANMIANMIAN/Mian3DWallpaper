<resources>
    <string name="app_name">米安3D壁纸</string>

    <string name="group_title">3D 空间壁纸</string>
    <string name="group_caption">让 vivo 主题 App 显示并启用 3D 壁纸入口。</string>
    <string name="enable_title">解锁 3D 壁纸</string>
    <string name="enable_summary">强制主题 App 内的五处能力判断通过。渲染引擎（libThemeProcess.so + VAGPlayer）本就内置在主题 App 里，无需额外安装。</string>

    <string name="usage_title">使用步骤</string>
    <string name="usage_body">1. 在 LSPosed 里启用本模块，并勾选「主题」作用域。\n2. 打开上方开关。\n3. 强行停止主题 App，再重新打开。\n4. 进入锁屏壁纸编辑，3D 入口就会出现。\n\n若仍无入口，查看 /storage/emulated/0/Android/media/com.mian.three/module.log，确认是哪一层判断被放行。</string>

    <string name="about_title">关于</string>
    <string name="about_body">从米安助手拆分出来的独立模块。只解锁主题 App 自带的 3D 壁纸能力，自身不提供任何渲染实现。</string>
    <string name="about_author">关于作者</string>
